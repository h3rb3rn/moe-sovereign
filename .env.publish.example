# ─── MoE Sovereign — Docs Publish Credentials ────────────────────────────────
# Copy this file to .env.publish and fill in your values.
# .env.publish is excluded from git (listed in .gitignore).
#
# Used by: scripts/publish-docs.sh

# ── all-inkl.com (docs.moe-sovereign.org) ─────────────────────────────────────
ALLINKL_SSH_HOST=ssh.moe-sovereign.all-inkl.com
ALLINKL_SSH_USER=www123_moe
ALLINKL_SSH_PORT=22
ALLINKL_REMOTE_DIR=/www/htdocs/docs/

# ── netcup VPS (moe-sovereign.org main site or alternate docs mirror) ─────────
NETCUP_SSH_HOST=your-server.netcup.net
NETCUP_SSH_USER=moe-sovereign
NETCUP_SSH_PORT=22
NETCUP_REMOTE_DIR=/var/www/docs.moe-sovereign.org/
